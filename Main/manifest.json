{
  "manifest_version": 3,
  "name": "BiliGo",
  "version": "0.1.0",
  "action": { "default_icon": { "128": "src/assets/icon-128.png" } },
  "description": "Bilibili 视频搜索助手",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [{
    "js": ["src/content/index.tsx"],
    "matches": ["*://*.bilibili.com/*"]
  }],
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "128": "src/assets/icon-128.png"
  }
}

